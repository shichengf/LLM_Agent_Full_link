# Copy to configs/cluster.env and edit values once. Use allocated compute nodes, never the login node.
# Every path/address below is fictional teaching configuration, not a real server.
# Keep actual values in ignored configs/cluster.env; never commit credentials or login details.
# Shared absolute project directory visible at the same path on every node.
export COURSE_ROOT=/shared/your_user/agent_systems_course
# Environment Python; use the same environment on every node.
export COURSE_PYTHON=/shared/your_user/envs/course-train/bin/python
export COURSE_NNODES=2
export COURSE_GPUS_PER_NODE=8
export COURSE_MASTER_ADDR=node0-private-address
export COURSE_MASTER_PORT=29571
export COURSE_RUN_ID=course-001
# Choose private interface only when your cluster requires it; never guess an interface name.
# export NCCL_SOCKET_IFNAME=ib0
# export GLOO_SOCKET_IFNAME=ib0
# export NCCL_IB_HCA=mlx5_0
# Model must be the same local snapshot on all nodes.
export COURSE_MODEL=/shared/models/Qwen2.5-72B-Instruct
export COURSE_TRAIN_MODEL=/shared/models/Qwen2.5-7B-Instruct
export COURSE_VERL_ROOT=/shared/your_user/verl
export COURSE_RAY_PORT=6381
export COURSE_DASHBOARD_PORT=8266
